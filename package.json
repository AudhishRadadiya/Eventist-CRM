{
  "name": "eventist-crm",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@ckeditor/ckeditor5-build-classic": "36.0.1",
    "@ckeditor/ckeditor5-react": "5.1.0",
    "@emotion/react": "11.10.5",
    "@emotion/styled": "11.10.5",
    "@fortawesome/fontawesome-svg-core": "6.4.0",
    "@fortawesome/free-solid-svg-icons": "6.4.0",
    "@fortawesome/react-fontawesome": "0.2.0",
    "@mui/icons-material": "5.11.9",
    "@mui/lab": "5.0.0-alpha.120",
    "@mui/material": "5.11.9",
    "@mui/styled-engine-sc": "5.11.9",
    "@mui/x-date-pickers": "5.0.19",
    "@reduxjs/toolkit": "1.9.3",
    "axios": "1.3.4",
    "base-64": "1.0.0",
    "bootstrap": "5.2.3",
    "ckeditor4-react": "4.1.2",
    "color-convert": "2.0.1",
    "cra-template-rb": "1.2.6",
    "dayjs": "1.11.7",
    "exceljs": "4.3.0",
    "file-saver": "2.0.5",
    "formik": "2.2.9",
    "fs": "0.0.1-security",
    "html2canvas": "1.4.1",
    "html2pdf.js": "0.10.1",
    "jquery": "3.7.0",
    "js-cookie": "3.0.1",
    "jspdf": "2.5.1",
    "jspdf-autotable": "3.5.29",
    "lodash": "4.17.21",
    "moment": "2.29.4",
    "primeicons": "6.0.1",
    "primereact": "9.0.0",
    "react": "^18.2.0",
    "react-bootstrap": "2.7.2",
    "react-dom": "^18.2.0",
    "react-js-pagination": "3.0.3",
    "react-material-file-upload": "0.0.4",
    "react-redux": "7.2.8",
    "react-router-dom": "6.8.1",
    "react-scripts": "5.0.1",
    "react-svg-injector": "2.0.2",
    "sass": "1.58.3",
    "styled-components": "5.3.6",
    "validator": "13.9.0",
    "yup": "1.0.2"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "start:prod": "yarn run build && serve -s build",
    "test:generators": "ts-node ./internals/testing/generators/test-generators.ts",
    "checkTs": "tsc --noEmit",
    "eslint": "eslint --ext js,ts,tsx",
    "lint": "yarn run eslint src",
    "lint:fix": "yarn run eslint --fix src",
    "lint:css": "stylelint src/**/*.css",
    "generate": "plop --plopfile internals/generators/plopfile.ts",
    "cleanAndSetup": "ts-node ./internals/scripts/clean.ts",
    "prettify": "prettier --write",
    "extract-messages": "i18next-scanner --config=internals/extractMessages/i18next-scanner.config.js"
  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "engines": {
    "node": ">=14.x"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "yarn run eslint --fix"
    ],
    "*.{md,json}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "eslint-config-prettier": "8.6.0",
    "eslint-plugin-prettier": "4.2.1"
  }
}
